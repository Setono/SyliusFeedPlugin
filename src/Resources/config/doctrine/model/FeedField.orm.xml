<?xml version="1.0" encoding="UTF-8" ?>

<doctrine-mapping xmlns="http://doctrine.apache.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine.apache.org/schemas/orm/doctrine-mapping
                  http://doctrine.apache.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Setono\SyliusFeedPlugin\Model\FeedField" table="setono_sylius_feed__feed_field">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="outputField" column="output_field" type="string" nullable="true"/>
        <field name="position" type="integer" nullable="true"/>
        <field name="sourceType" column="source_type" type="string"/>
        <field name="sourceValue" column="source_value" type="text" nullable="true"/>
        <field name="transformations" type="json"/>
        <field name="condition" column="field_condition" type="json" nullable="true"/>
        <field name="requiresInput" column="requires_input" type="boolean"/>

        <many-to-one field="source" target-entity="Setono\SyliusFeedPlugin\Model\FeedSource" inversed-by="fields">
            <join-column name="source_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
