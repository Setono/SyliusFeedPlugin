<?xml version="1.0" encoding="UTF-8" ?>

<doctrine-mapping xmlns="http://doctrine.apache.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine.apache.org/schemas/orm/doctrine-mapping
                  http://doctrine.apache.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Setono\SyliusFeedPlugin\Model\Feed" table="setono_sylius_feed__feed">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="code" type="string" unique="true"/>
        <field name="enabled" type="boolean"/>
        <field name="format" type="string" nullable="true"/>
        <field name="state" type="string"/>
        <field name="formatConfig" column="format_config" type="json"/>
        <field name="lastGeneratedAt" column="last_generated_at" type="datetime_immutable" nullable="true"/>

        <many-to-many field="channels" target-entity="Sylius\Component\Core\Model\ChannelInterface">
            <join-table name="setono_sylius_feed__feed_channels">
                <join-columns>
                    <join-column name="feed_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="channel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <one-to-many field="sources" target-entity="Setono\SyliusFeedPlugin\Model\FeedSource" mapped-by="feed" orphan-removal="true">
            <cascade>
                <cascade-all/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>

        <one-to-many field="translations" target-entity="Setono\SyliusFeedPlugin\Model\FeedTranslation" mapped-by="translatable" index-by="locale" orphan-removal="true">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
